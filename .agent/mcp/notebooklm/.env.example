# Google Authentication for NotebookLM
# You need to extract these cookies from your browser session on notebooklm.google.com
# 1. Open Developer Tools (F12) -> Application -> Cookies
# 2. Look for "__Secure-1PSID" and "__Secure-1PSIDTS"

GOOGLE_SESSION_TOKEN=your_secure_1psid_here
GOOGLE_TOKEN_P0=your_secure_1psidts_here
